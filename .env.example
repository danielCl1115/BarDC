# Copia este archivo como  .env.local  y rellena los valores.
# Los encuentras en Supabase -> Project Settings -> API

# URL del proyecto (termina en .supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (empieza por eyJ...). Puede ir al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" (SECRETA). Solo se usa en el servidor para crear usuarios.
# NUNCA la subas a git ni la pongas en código del navegador.
SUPABASE_SERVICE_ROLE_KEY=
